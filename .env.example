# Copier vers `.env` — ne jamais committer `.env`.
AQS_DB_USER=aquasensus
AQS_DB_PASSWORD=changez-moi
AQS_DB_NAME=aquasensus
AQS_DB_URL=jdbc:postgresql://db:5432/aquasensus
AQS_JWT_SECRET=remplacer-par-32-octets-minimum-secret
AQS_ADMIN_PASSWORD=ChangeMoi!2026
AQS_INTERNAL_SECRET=dev-internal-secret-change-me
AQS_CORS_ORIGINS=http://localhost:4200,http://localhost
# Reverse proxy : dev | demo | prod (fichiers infra/nginx/*.conf)
AQS_NGINX_CONF=dev
# Démo soutenance uniquement (seed Flyway). Ne pas mettre `prod` ici par erreur.
# AQS_PROFILE=demo
AQS_PORT=8080
